{
  "name": "okf-core-concept-schemas",
  "version": "1.1.0",
  "okf_version": "0.2",
  "schema_version": 1,
  "description": "Shared OKF concept envelope and core types. Domain plugins add their own schemas/okf-concepts/ directories; validators merge registries.",
  "base": "BaseConcept.schema.json",
  "plugin": "okf-plugin",
  "concepts": [
    "BaseConcept",
    "Catalog",
    "ContextPack",
    "Project",
    "TicketLink",
    "Epic",
    "Story",
    "Task",
    "Subtask",
    "Bug",
    "Branch",
    "DecisionRecord",
    "Feature",
    "AgentNode",
    "Workflow",
    "Harness",
    "SharedState",
    "ToolCapability",
    "Dataset",
    "Table",
    "Metric",
    "Playbook",
    "Runbook",
    "API",
    "Reference"
  ],
  "catalogs": {
    "tickets": { "owner": "okf-plugin", "types": ["TicketLink"] },
    "epics": { "owner": "project-knowledge-capture", "types": ["Epic"] },
    "stories": { "owner": "project-knowledge-capture", "types": ["Story"] },
    "tasks": { "owner": "project-knowledge-capture", "types": ["Task"] },
    "subtasks": { "owner": "project-knowledge-capture", "types": ["Subtask"] },
    "bugs": { "owner": "project-knowledge-capture", "types": ["Bug"] },
    "branches": { "owner": "project-knowledge-capture", "types": ["Branch"] },
    "decisions": { "owner": "project-knowledge-capture", "types": ["DecisionRecord"] },
    "features": { "owner": "project-knowledge-capture", "types": ["Feature"] },
    "projects": { "owner": "okf-plugin", "types": ["Project"] },
    "packs": { "owner": "shared", "types": ["ContextPack"], "indexed": false },
    "agents": { "owner": "okf-plugin", "types": ["AgentNode"] },
    "workflows": { "owner": "okf-plugin", "types": ["Workflow"] }
  },
  "catalog_ownership": {
    "okf-plugin": ["tickets", "agents", "workflows", "projects"],
    "project-knowledge-capture": [
      "meetings", "experiments", "discoveries", "decisions", "assumptions",
      "questions", "features", "requirements", "specs", "designs", "releases",
      "code", "packages", "tickets", "epics", "stories", "tasks", "subtasks",
      "bugs", "branches", "projects", "risks", "acceptance"
    ],
    "system-architecture-capture": ["modules", "services", "systems", "apis", "environments"],
    "data-engineering-knowledge-capture": [
      "tables", "views", "streams", "lakes", "marts", "metrics", "dashboards"
    ],
    "okf-agent-graph": ["runtime", "ops", "memory", "evaluation"]
  },
  "notes": {
    "Module": "In a shared second brain, Module lives in modules/ (SAC convention). PKC historically aliased Module → packages/; new writes should use modules/.",
    "Package": "Build unit. Always packages/.",
    "Dashboard": "DEKC = BI dashboard. SAC = observability dashboard. Same type name, different catalogs (dashboards/ vs observability/).",
    "required_fields": "BaseConcept v1 requires only type + title. Per-type extras live in x-recommended and warn (error only with --strict).",
    "work_items": "Epic/Story/Task/Subtask/Bug are first-class. TicketLink remains the generic/legacy projection. Branch is the source-control concept."
  }
}
